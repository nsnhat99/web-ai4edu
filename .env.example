POSTGRES_URL=
BLOB_READ_WRITE_TOKEN=

# --- Auth ---
# Secret dùng để ký session token. Tối thiểu 32 ký tự, sinh bằng:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Đổi secret này sẽ làm mọi phiên đang đăng nhập bị đăng xuất.
AUTH_SECRET=

# Tài khoản admin đầu tiên. Chỉ dùng khi bảng users còn RỖNG — seed sẽ hash mật khẩu
# trước khi lưu. Bảng users đã có dữ liệu thì đổi mật khẩu bằng:
#   npm run set-admin-password -- <username> <password>
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@daihocthudo.edu.vn

# Google Sheets + Drive (public form submissions)
# Base64-encoded service account JSON key. Generate with:
#   base64 -w 0 service-account.json > key.b64
GOOGLE_SERVICE_ACCOUNT_JSON=
# ID of the Google Spreadsheet (must contain tabs: Papers, Registrations, Contacts)
GOOGLE_SHEET_ID=
# ID of the Drive folder (must be inside a Shared Drive; share with service account email as Content Manager)
GOOGLE_DRIVE_FOLDER_ID=
